# --- Seguridad ---
# Clave para firmar las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Activar depuración SOLO en desarrollo (0 = apagado, 1 = encendido).
FLASK_DEBUG=0

# Marcar la cookie de sesión como Secure (solo se envía por HTTPS).
# 0 para la LAN local por HTTP; ponlo en 1 en un hosting con HTTPS.
SESSION_COOKIE_SECURE=0

# Contraseña del admin que se crea automáticamente la primera vez.
ADMIN_PASSWORD=admin

# --- Puerto de la app en Docker ---
WEB_PORT=8080

# --- Base de datos PostgreSQL ---
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistica_db

# --- CORS (opcional) ---
# Déjalo vacío en una LAN cerrada (front y API comparten origen).
# Si necesitas permitir orígenes externos, sepáralos por comas.
CORS_ORIGINS=
