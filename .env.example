# ==========================================================================
# Copia este archivo como  .env  y ajusta los valores.
# NUNCA subas el .env real a un repositorio ni lo compartas.
# La aplicación lee estas variables al arrancar.
# ==========================================================================

# --- Seguridad ---
# Clave para firmar las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Activar depuración SOLO en desarrollo (0 = apagado, 1 = encendido).
# En el servidor/laptop de producción debe quedar en 0.
FLASK_DEBUG=0

# Marcar la cookie de sesión como Secure (solo se envía por HTTPS).
# Déjalo en 0 para la LAN local por HTTP; ponlo en 1 en un hosting con HTTPS.
SESSION_COOKIE_SECURE=0

# Contraseña del admin que se crea automáticamente la primera vez.
ADMIN_PASSWORD=admin

# --- Puerto de la app en Docker ---
# Puerto del host donde quedará la app al usar Docker Compose (dentro del
# contenedor siempre es 8080). Solo aplica a `docker compose`. Ej.: 8080.
WEB_PORT=8080

# --- Base de datos PostgreSQL ---
# OPCIÓN A (Docker Compose, recomendado): NO toques DB_HOST/DB_PORT; el
#   docker-compose.yml ya conecta la app al contenedor de la base (db:5432)
#   usando DB_USER/DB_PASSWORD/DB_NAME de aquí. Deja DATABASE_URL vacío.
#
# OPCIÓN B (hosting en la nube: Render, Railway...): define una única cadena de
#   conexión; la app ignora las variables DB_* de abajo. El esquema
#   "postgres://" o "postgresql://" se normaliza solo.
#   DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_base
#
# OPCIÓN C (nativo, python app.py): usa DB_HOST/DB_PORT apuntando a tu Postgres.
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistica_db

# --- Parámetros financieros ---
# El precio del combustible y el margen de ganancia ya NO se configuran aquí:
# se editan desde la pantalla "Configuración" dentro de la aplicación (quedan
# guardados en la base de datos, tabla configuracion_financiera). El valor
# inicial (0.5 $/litro) se define en schema_v2.sql / migracion_v3.sql.

# --- CORS (opcional) ---
# Déjalo vacío en una LAN cerrada (front y API comparten origen).
# Si necesitas permitir orígenes externos, sepáralos por comas.
CORS_ORIGINS=
